<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <!-- Publisher must match the subject of the signing certificate (uwp/build.ps1). -->
  <Identity
    Name="PokeredUWP.PokemonBlue"
    Publisher="CN=PokeredUWP"
    Version="1.0.0.0" />

  <!-- Required by the packaging tools; must differ between the two apps. -->
  <mp:PhoneIdentity PhoneProductId="c26e88d1-3779-4bdb-bf9f-f03926a7e1f6" PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Pokémon Blue</DisplayName>
    <PublisherDisplayName>pokered-uwp</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="PokemonBlue.App">
      <uap:VisualElements
        DisplayName="Pokémon Blue"
        Description="Pokémon Blue, built from the pret/pokered disassembly."
        BackgroundColor="#0E63AA"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Pokémon Blue" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0E63AA" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
